APP_NAME=flexd-jobx-web
APP_ENV=development
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flexd_jobx
DB_USER=flexd_jobx
DB_PASSWORD=
DB_SSL_DISABLED=true
# Development only: traffic is unencrypted. Set false for verified TLS.
# Optional path to trusted MySQL CA certificate when TLS is enabled.
# DB_SSL_CA=C:/certificates/mysql-ca.pem

STORAGE_CLOUD_PROVIDER=aws
STORAGE_KEY=
STORAGE_SECRET=
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=
STORAGE_PATH=/jobx
# Set only after confirming the public URL matches the storage prefix.
# STORAGE_PUBLIC_URL=https://bucket.s3.ap-southeast-1.amazonaws.com/jobx
STORAGE_ACL=false

# Required for auth: generate a random secret of at least 32 bytes.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=jobx
JWT_AUDIENCE=jobx-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI-compatible Chat Completions API; no provider selection.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
